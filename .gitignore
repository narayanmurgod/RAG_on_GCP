# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files (keep example public.tfvars / private.tfvars)
*.auto.tfvars
terraform.tfvars

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include lockfile
!.terraform.lock.hcl
